[Unit]
Description=PKCS11RS YubiHSM connector
After=network.target

[Service]
Type=simple
User=pkcs11rs-connector
Group=pkcs11rs-connector
ExecStart=/usr/local/bin/pkcs11rs-connector --listen 0.0.0.0:12345 --allow-insecure-http
Environment=RUST_LOG=pkcs11rs_connector=info
Restart=on-failure
RestartSec=2s
StateDirectory=pkcs11rs-connector
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
